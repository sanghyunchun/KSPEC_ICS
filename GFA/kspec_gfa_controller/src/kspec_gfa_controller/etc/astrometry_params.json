{
    "paths": {
        "save_root": "~/work/DATA/GFADATA/img",
        "directories": {
          "raw_images": "raw",
          "processed_images": "procimg",
          "temp_files": "tempfiles",
          "final_astrometry_images": "astroimg",
          "offset_astrometry_images": "astroimg",
          "offset_processed_images": "procimg",
          "cutout_directory": "cutout",
          "star_catalog": "star_catalog",
          "grab_images": "grab",
          "guiding_save": "guiding_save",
          "pointing_save": "pointing_save",
            "unclean_images": "unclean"
        }
      },
    "pointing_filter": {
        "min_valid_images": 5,
        "min_std_bg": 0.3,
        "min_peaks": 10,
        "min_brightest_flux": 3000,
        "dao": {
          "fwhm": 3.0,
          "sigma_threshold": 5.0
        }
    },
    "settings": {
        "cpu": {
            "limit": 6 
        },
        "image_processing": {
            "skycoord": {
                "pre_skycoord1": [1000, 255],
                "pre_skycoord2": [1000, 767]
            },
            "sub_indices": {
                "sub_ind1": [0, 1024, 0, 512],
                "sub_ind2": [0, 1024, 512, 1024]
            },
            "crop_indices": [12, 979, 1, 1023],
            "pixel_scale": 0.4
        }
    },
    "astrometry": {
        "scale_range": ["0.03", "0.16"],
        "radius": 5
    },
    "detection": {
        "box_size": 40,
        "criteria": {
            "critical_outlier": 0.25
        },
        "peak_detection": {
            "max": 4000,
            "min": 300
        }
    },
    "catalog_matching": {
        "fields": {
            "ra_column": "index_ra",
            "dec_column": "index_dec",
            "mag_flux": "FLUX"
        },
        "tolerance": {
            "angular_distance": 0.06,
            "mag_flux_min": 300
        }
    }
}
